{
    "version":  "1.0",
    "note":  "语义条款闸门：card-audit.ps1 -SelfTest 之外的第二道闸。防止『卡被掏空但结构仍合法』——12 条空话 + 假回执曾骗过审计（ERRORS: 0）。每条只需命中 any 里任一正则即算存在。",
    "clauses":  [
                    {
                        "id":  "input_gate",
                        "name":  "输入闸门（缺对象+动作先问，不空转）",
                        "any":  [
                                    "第 ?0 ?条",
                                    "输入闸门"
                                ]
                    },
                    {
                        "id":  "env_map",
                        "name":  "环境与定位一次摸清（禁盘符根递归、限深度超时）",
                        "any":  [
                                    "一次摸清",
                                    "禁止从",
                                    "探明",
                                    "整库遍历"
                                ]
                    },
                    {
                        "id":  "caps",
                        "name":  "触顶换法（读2/搜2/错3/20 秒）",
                        "any":  [
                                    "读 ?2",
                                    "搜索 ?2",
                                    "报错 ?3",
                                    "触顶",
                                    "20 ?秒"
                                ]
                    },
                    {
                        "id":  "evidence",
                        "name":  "完成=运行时证据（编译过/端口在听不算）",
                        "any":  [
                                    "运行时证据",
                                    "原样输出",
                                    "编译过"
                                ]
                    },
                    {
                        "id":  "ripple",
                        "name":  "先查调用方再改（改动半径）",
                        "any":  [
                                    "调用方",
                                    "RIPPLE",
                                    "影响面"
                                ]
                    },
                    {
                        "id":  "process",
                        "name":  "进程与命令收口（PID/端口/禁按名杀/非交互）",
                        "any":  [
                                    "PID",
                                    "端口",
                                    "批量杀",
                                    "非交互"
                                ]
                    },
                    {
                        "id":  "gate",
                        "name":  "备份与不可逆闸门（IMPACT）",
                        "any":  [
                                    "IMPACT"
                                ]
                    },
                    {
                        "id":  "unattended",
                        "name":  "无人值守设墙（预算+HANDOFF）",
                        "any":  [
                                    "HANDOFF",
                                    "无人值守"
                                ]
                    },
                    {
                        "id":  "cn_windows",
                        "name":  "中文 Windows 坑位（GBK/5.1/引号）",
                        "any":  [
                                    "GBK",
                                    "中文 Windows",
                                    "5\\.1"
                                ]
                    },
                    {
                        "id":  "reanchor",
                        "name":  "压缩后重锚（REANCHOR + 账本不新建）",
                        "any":  [
                                    "REANCHOR",
                                    "compacted-summary"
                                ]
                    },
                    {
                        "id":  "fact",
                        "name":  "事实闸门（不编 API/参数/数字，纠错前提）",
                        "any":  [
                                    "不编",
                                    "编造",
                                    "GUESS",
                                    "前提.*冲突",
                                    "以证据为准"
                                ]
                    },
                    {
                        "id":  "delivery",
                        "name":  "交付即产物（首行即结论、0 套话 0 emoji）",
                        "any":  [
                                    "首行即",
                                    "交付即产物",
                                    "emoji",
                                    "开场白"
                                ]
                    },
                    {
                        "id":  "reproduce",
                        "name":  "先复现再修（不凭记忆改）",
                        "any":  [
                                    "复现",
                                    "不凭记忆改"
                                ]
                    },
                    {
                        "id":  "hypotheses",
                        "name":  "多假设诊断 + 空转换维度",
                        "any":  [
                                    "≥2 个假设",
                                    "假设",
                                    "换维度"
                                ]
                    },
                    {
                        "id":  "certainty",
                        "name":  "确定性分级（确定/推测）",
                        "any":  [
                                    "确定/推测",
                                    "推测须给验证路径"
                                ]
                    },
                    {
                        "id":  "scan_cap",
                        "name":  "扫描/枚举类硬上限 20 秒（v2.10.0 句柄枚举 240 秒事故）",
                        "any":  [
                                    "扫描/枚举/全盘",
                                    "硬上限 20 秒"
                                ]
                    },
                    {
                        "id":  "wait_once",
                        "name":  "后台 Job 单次等待上限（v2.10.0 两次 wait 干等事故）",
                        "any":  [
                                    "wait=true",
                                    "只准等 1 次"
                                ]
                    },
                    {
                        "id":  "silent_cap",
                        "name":  "静默上限：连续 5 步无对外文字必须给进展（v2.10.0 16 步 0 输出事故）",
                        "any":  [
                                    "连续 5 步",
                                    "一句进展"
                                ]
                    },
                    {
                        "id":  "switch_visible",
                        "name":  "换维度必须说换到哪去（熔断要有可观测回执）",
                        "any":  [
                                    "换维度，并说",
                                    "换到哪去"
                                ]
                    }
                ]
}
